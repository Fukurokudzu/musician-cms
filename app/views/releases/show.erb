<div class="release-show-container">
  <div class="release-show-left">
    <div class="tracks-container" data-release-id="<%= @release.id %>">
      <h1><%= @release.title %></h1>
      <% if @tracks.any? %>
        <ul>
          <%= render(partial: 'track', collection: @tracks) %>
        </ul>
      <% else %>
        <div class="release-no-published-tracks"><%= t('release.show.no_published_tracks') %></div>
      <% end %>
    </div>
    <% if @md_description.present? %>
      <div class="release-show-description">
        <%= @md_description %>
      </div>
    <% end %>
    <div class="release-show-info">
      <p><%= t('release.show.tracks_count').downcase %> <%= @tracks.count %>, <%= t('release.show.duration').downcase %> <%= @release.duration_humanized(published: true) %></p>
      <p>
        <%= t('release.show.released_on', date: l(@release.release_date, format: '%-d %B %Y').downcase) if @release.release_date %>
        <%= t('release.show.released_by', publisher: @release.publisher) if @release.publisher.present? %>
      </p>
      <% if @release.allow_zip_download? %>
        <p class="release-download">
          <%= link_to download_release_path(@release), class: 'release-download-link',
                      title: t('release.show.download_zip').downcase do %>
            <i class="fas fa-download" aria-hidden="true"></i>
            <span><%= t('release.show.download_zip').downcase %></span>
          <% end %>
        </p>
      <% end %>
    </div>
  </div>
  <div class="release-show-cover">
    <% if @release.cover.attached? %>
      <%= link_to url_for(@release.cover), target: '_blank', rel: 'noopener', title: t('release.show.view_cover') do %>
        <%= cover_image_tag @release.cover, size: [1000, 1000], alt: @release.title, class: 'release-show-cover-image', id: @release.id.to_s + '_cover', loading: 'eager', fetchpriority: 'high' %>
      <% end %>
    <% end %>
  </div>
</div>
