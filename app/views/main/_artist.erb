<% releases = artist.releases.sort_by { |r| [r.release_date ? -r.release_date.to_time.to_i : 1, r.title.to_s.downcase] } %>
<% if releases.any? %>
  <div class="releases-container">
    <%= link_to artist_path(artist), class: 'main-artist-title' do %>
      <h2><%= artist.title %></h2>
    <% end %>
    <%= render(partial: 'main/release', collection: releases) %>
  </div>
<% end %>

