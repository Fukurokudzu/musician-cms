<div class="admin-artists">
  <div class="admin-actions admin-releases-header">
    <%= link_to t('admin.artists.new', default: 'New artist'), new_admin_artist_path, class: 'btn btn-primary',
                data: { turbo_stream: true, turbo_prefetch: false } %>
  </div>



  <% if @artists.any? %>
    <div class="admin-releases-list">
      <%= render partial: 'artist', collection: @artists %>
    </div>
  <% end %>
</div>
