<div class="admin-release-details">
  <div class="admin-release admin-release-summary">
    <div class="release-cover-wrap">
      <% if @release.cover.attached? %>
        <%= image_tag @release.cover.variant(resize_to_limit: [160, 160]), class: 'release-cover', loading: 'lazy', decoding: 'async' %>
      <% else %>
        <div class="release-cover release-cover--placeholder" aria-hidden="true"></div>
      <% end %>
    </div>
    <div class="release-title">
      <%= @release.artist.title %> - <%= @release.title %>
    </div>
    <div class="admin-release-stats">
      <div class="admin-release-stats-item">
        <span class="admin-release-stats-item-title"><%= t('admin.release.fields.status') %>:</span>
        <span class="admin-release-stats-item-value"><%= @release.status.present? ? t("admin.statuses.#{@release.status}", default: @release.status.humanize) : '-' %></span>
      </div>
      <div class="admin-release-stats-item">
        <span class="admin-release-stats-item-title"><%= t('admin.release.fields.genre') %>:</span>
        <span class="admin-release-stats-item-value"><%= @release.genre.presence || '-' %></span>
      </div>
      <div class="admin-release-stats-item">
        <span class="admin-release-stats-item-title"><%= t('admin.release.fields.release_date') %>:</span>
        <span class="admin-release-stats-item-value"><%= @release.release_date || '-' %></span>
      </div>
      <div class="admin-release-stats-item">
        <span class="admin-release-stats-item-title"><%= t('admin.release.zip_download') %>:</span>
        <span class="admin-release-stats-item-value"><%= @release.allow_zip_download? ? t('admin.release.enabled') : t('admin.release.disabled') %></span>
      </div>
      <div class="admin-release-stats-item">
        <span class="admin-release-stats-item-title"><%= t('admin.release.stats.plays_count') %>:</span>
        <span class="admin-release-stats-item-value"><%= @release.plays_count %></span>
      </div>
      <div class="admin-release-stats-item">
        <span class="admin-release-stats-item-title"><%= t('admin.release.stats.tracks_count') %>:</span>
        <span class="admin-release-stats-item-value"><%= @release.tracks.count %></span>
      </div>
      <div class="admin-release-stats-item">
        <span class="admin-release-stats-item-title"><%= t('admin.release.stats.duration') %>:</span>
        <span class="admin-release-stats-item-value"><%= @release.duration_humanized %></span>
      </div>
      <div class="admin-actions admin-release-summary-actions">
        <%= link_to t('admin.release.edit'), edit_admin_release_path(@release), class: 'btn btn-primary',
                    data: { turbo_stream: true, turbo_prefetch: false } %>
        <%= link_to t('admin.release.back_to_releases'), admin_releases_path, class: 'btn',
                    data: { turbo_stream: true, turbo_prefetch: false } %>
        <%= button_to t('admin.release.delete'), admin_release_path(@release), method: :delete, data: { turbo_confirm: t('admin.release.confirm_delete') }, class: 'btn btn-danger' %>
      </div>
    </div>
  </div>

  <div class="tracks-list">
    <h3><%= t('admin.release.tracks') %></h3>
    <% @release.tracks.by_position.each do |track| %>
      <div class="track-item track-item--<%= track.status %>">
        <span class="track-pos"><%= track.pos || '-' %></span>
        <span class="track-title"><%= track.title %></span>
        <span class="track-status"><%= track.status.present? ? t("admin.statuses.#{track.status}", default: track.status.humanize) : '-' %></span>
      </div>
    <% end %>

    <%= form_with url: add_tracks_admin_release_path(@release), class: 'add-track-form', multipart: true,
                  data: { turbo_stream: true } do |form| %>
      <div class="form-group">
        <%= form.label :tracks, t('admin.release.add_track') %>
        <%= form.file_field :tracks, multiple: true, accept: 'audio/*', required: true, class: 'form-control' %>
      <p class="admin-field-hint"><%= t('admin.release.hints.tracks', default: 'Audio files: %{extensions}', extensions: Setting.track_extensions.join(', ')) %></p>
      <p class="admin-field-hint"><%= t('admin.release.hints.tracks', default: 'Audio files: %{extensions}', extensions: Setting.track_extensions.join(', ')) %></p>
      </div>
      <div class="form-actions">
        <%= form.submit t('admin.release.add') %>
      </div>
    <% end %>
  </div>
</div>
