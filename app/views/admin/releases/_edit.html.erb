<div class="admin-release-edit">
  <h2><%= t('admin.release.edit_title') %></h2>

  <%= form_with model: [:admin, @release], data: { turbo_stream: true } do |form| %>
    <div class="form-group">
      <%= form.label :title, t('admin.release.fields.title') %>
      <%= form.text_field :title %>
    </div>
    <div class="form-group">
      <%= form.label :genre, t('admin.release.fields.genre') %>
      <%= form.text_field :genre %>
    </div>
    <div class="form-group">
      <%= form.label :publisher, t('admin.release.fields.publisher') %>
      <%= form.text_field :publisher %>
    </div>
    <div class="form-group">
      <%= form.label :release_date, t('admin.release.fields.release_date') %>
      <%= form.date_field :release_date %>
    </div>
    <div class="form-group">
      <%= form.label :description, t('admin.release.fields.description') %>
      <%= form.text_area :description, class: 'admin-md-editor', data: { controller: 'md-editor' } %>
    </div>
    <div class="form-group">
      <%= form.label :status, t('admin.release.fields.status') %>
      <%= form.select :status, Release.statuses.keys.map { |s| [t("admin.statuses.#{s}", default: s.humanize), s] }, include_blank: true %>
    </div>
    <div class="form-group form-group-checkbox">
      <%= form.label :allow_zip_download, class: 'checkbox-label' do %>
        <%= form.check_box :allow_zip_download %>
        <span><%= t('admin.release.allow_zip_download') %></span>
      <% end %>
    </div>

    <h3><%= t('admin.release.tracks') %></h3>
    <div class="admin-bulk-bar">
      <label class="checkbox-label">
        <input type="checkbox" onclick="document.querySelectorAll('.track-bulk-checkbox').forEach(function(cb){ cb.checked = this.checked; }.bind(this))">
        <span><%= t('admin.bulk.select_all', default: 'Select all') %></span>
      </label>
      <select name="bulk_status">
        <option value=""><%= t('admin.bulk.choose_action', default: 'Choose action') %></option>
        <% Track.statuses.keys.each do |s| %>
          <option value="<%= s %>"><%= t("admin.statuses.#{s}", default: s.humanize) %></option>
        <% end %>
      </select>
      <%= form.submit t('admin.bulk.apply', default: 'Apply'), name: 'bulk_apply' %>
    </div>
    <div id="tracks" class="admin-edit-tracks">
      <%= form.fields_for :tracks, @release.tracks.by_position do |track_form| %>
        <div class="track-fields track-fields--<%= track_form.object.status %>">
          <div class="track-field track-field--select">
            <input type="checkbox" name="track_ids[]" value="<%= track_form.object.id %>" class="track-bulk-checkbox">
          </div>
          <div class="track-field track-field--title">
            <%= track_form.label :title, t('admin.release.fields.track_title') %>
            <%= track_form.text_field :title %>
          </div>
          <div class="track-field track-field--pos">
            <%= track_form.label :pos, t('admin.release.fields.track_pos') %>
            <%= track_form.number_field :pos %>
          </div>
          <div class="track-field track-field--status">
            <%= track_form.label :status, t('admin.release.fields.track_status') %>
            <%= track_form.select :status, Track.statuses.keys.map { |s| [t("admin.statuses.#{s}", default: s.humanize), s] }, include_blank: true %>
          </div>
        </div>
      <% end %>
    </div>

    <div class="form-actions">
      <%= form.submit t('admin.release.save') %>
      <%= link_to t('admin.release.cancel'), admin_release_path(@release), class: 'btn',
                  data: { turbo_stream: true, turbo_prefetch: false } %>
    </div>
  <% end %>
</div>