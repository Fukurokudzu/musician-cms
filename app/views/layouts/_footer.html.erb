<%# Hidden shortcut: three quick clicks on the footer open /admin. %>
<footer id="footer" class="bg-dark text-center mt-auto"
        <% unless admin? %>data-controller="secret-admin" data-action="click->secret-admin#click"<% end %>>
  <div class="footer-text">
<% if Setting.footer_link_type == 'url' && Setting.footer_url.present? %>
  <a href="<%= Setting.footer_url %>" class="text-white"><%= '© ' + Setting.footer_url %></a>
<% else %>
  <%
    mailto = "mailto:#{Setting.footer_email}"
    mailto += "?subject=#{ERB::Util.url_encode(Setting.footer_subject)}" if Setting.footer_subject.present?
  %>
  <a href="<%= mailto %>" class="text-white"><%= '© ' + Setting.footer_email %></a>
<% end %>
  </div>
</footer>
