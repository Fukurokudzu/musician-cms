.admin {
  width: 100%;
  min-height: calc(100vh - 10rem);
  background-color: #fcfcfc;
  color: #212529;
  padding: 1.5rem;
  border-radius: 0.25rem;
}

.admin h2 {
  margin-bottom: 1.25rem;
}

.admin h3 {
  margin: 1.25rem 0 0.75rem;
}

/* Tabs */

.admin .nav-tabs {
  margin-bottom: 1.5rem;
}

/* Forms */

.admin form {
  max-width: 36rem;
}

.admin .form-group,
.admin .mb-3,
.admin .field {
  margin-bottom: 1rem;
}

.admin label {
  display: block;
  margin-bottom: 0.25rem;
  font-weight: 600;
}

.admin input[type="text"],
.admin input[type="email"],
.admin input[type="password"],
.admin input[type="number"],
.admin input[type="date"],
.admin select,
.admin textarea {
  display: block;
  width: 100%;
  padding: 0.375rem 0.75rem;
  border: 1px solid #ced4da;
  border-radius: 0.25rem;
  background-color: #fff;
}

.admin input[type="file"] {
  display: block;
  width: 100%;
}

.admin input[type="color"] {
  display: block;
  width: 3rem;
  height: 2rem;
  padding: 0;
  border: 1px solid #ced4da;
  border-radius: 0.25rem;
}

.admin input[type="checkbox"] {
  width: 1.1rem;
  height: 1.1rem;
  cursor: pointer;
}

.admin .form-actions,
.admin .admin-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 1rem;
  margin-top: 1.5rem;
}

.admin .admin-actions {
  margin-top: 1rem;
}

/* button_to wraps the control into its own form: keep it inline so buttons
   sit on the same line as plain links instead of dropping to a new row. */
.admin form.button_to {
  display: inline-block;
  max-width: none;
  margin: 0;
  padding: 0;
  vertical-align: middle;
}

.admin input[type="submit"],
.admin .btn {
  display: inline-block;
  padding: 0.375rem 0.75rem;
  border: 1px solid #ced4da;
  border-radius: 0.25rem;
  background-color: #e9ecef;
  color: #212529;
  font-family: inherit;
  font-size: 1rem;
  line-height: 1.5;
  text-align: center;
  text-decoration: none;
  white-space: nowrap;
  cursor: pointer;
  vertical-align: middle;
}

.admin input[type="submit"]:hover,
.admin .btn:hover {
  background-color: #dde1e5;
  border-color: #b9c1c9;
  color: #212529;
}

.admin input[type="submit"],
.admin .btn-primary {
  background-color: #0d6efd;
  border-color: #0d6efd;
  color: #fff;
}

.admin input[type="submit"]:hover,
.admin .btn-primary:hover {
  background-color: #0b5ed7;
  border-color: #0b5ed7;
  color: #fff;
}

.admin .btn-light {
  background-color: #f8f9fa;
  border-color: #ced4da;
  color: #212529;
}

.admin .btn-light:hover {
  background-color: #d3d6d9;
  border-color: #b9c1c9;
  color: #212529;
}

.admin .btn-danger {
  background-color: #dc3545;
  border-color: #dc3545;
  color: #fff;
}

.admin .btn-danger:hover {
  background-color: #bb2d3b;
  border-color: #b02a37;
  color: #fff;
}

/* Release edit: tracks */

.admin .track-fields {
  display: grid;
  grid-template-columns: 1fr 5rem 10rem;
  gap: 0.5rem 1rem;
  align-items: end;
  padding: 0.75rem;
  margin-bottom: 0.75rem;
  border: 1px solid #dee2e6;
  border-radius: 0.25rem;
  background-color: #fff;
}

.admin .track-fields label {
  grid-row: 1;
}

/* Release details */

.admin .tracks-list {
  margin-top: 1.5rem;
  max-width: 36rem;
}

.admin .track-item {
  display: grid;
  grid-template-columns: 2rem 1fr 6rem;
  gap: 1rem;
  padding: 0.375rem 0;
  border-bottom: 1px solid #eee;
}

/* Add track form (release details) */

.admin .add-track-form {
  margin-top: 1.5rem;
}

/* Artist: update / destroy actions */

.admin .destroy-button-container {
  margin-top: 1.5rem;
}

/* Library: path field and the save/scan buttons share one row */

.admin .library-actions {
  margin-top: 0;
}

.admin .library-actions > form:not(.button_to) {
  flex: 1 1 20rem;
  max-width: 36rem;
  margin: 0;
}

.admin .library-field {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.5rem 1rem;
}

.admin .library-field label {
  margin-bottom: 0;
  white-space: nowrap;
}

.admin .library-field input[type="text"] {
  flex: 1 1 14rem;
  width: auto;
  min-width: 10rem;
  margin: 0;
}

.admin .release-cover {
  max-width: 10rem;
  max-height: 10rem;
  margin-bottom: 1rem;
}

/* Releases index */

.admin-releases-header {
  margin-bottom: 1rem;
}

/* Background preview (theme tab) */

.admin-bg-preview {
  margin-bottom: 0.5rem;
}

.admin-bg-preview img {
  max-width: 16rem;
  max-height: 9rem;
  border: 1px solid #ced4da;
  border-radius: 0.25rem;
  display: block;
}
