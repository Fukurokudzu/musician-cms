.artist-show-container, .artist-show-albums {
  margin-top: 1rem;
  width: 90%;
  padding: 1rem;
  background-color: rgba(0, 0, 0, 0.5);
  border-radius: 5px;
  color: var(--text-color);
  border-right: solid 3px var(--accent-color);
}

blockquote {
  font-style: italic;
  font-size: 1rem;
  margin: 1rem 0;
  border-left: solid 3px var(--text-color);
  padding-left: 1rem;
}

.artist-show-container a {
  color: var(--a-color);
}

.artist-show-albums .albums-list {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(5rem, 1fr));
  gap: 1rem;
}

.artist-show-albums .release-item {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 0.25rem;
}

.artist-show-albums img {
  width: 4rem;
  height: auto;
  border-radius: 5px;
}
