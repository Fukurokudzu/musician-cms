# Optional: override container user/group IDs (used at build time)
UID=1000
GID=1000

# Optional: build/runtime revision info shown in Admin -> About diagnostics.
# .git is excluded from Docker build context, so pass these explicitly:
#   GIT_COMMIT=$(git describe --tags --exact-match 2>/dev/null || git rev-parse --short HEAD) GIT_BRANCH=$(git rev-parse --abbrev-ref HEAD) docker compose build
# or set them here before building.
GIT_COMMIT=
GIT_BRANCH=
