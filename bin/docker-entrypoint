#!/bin/bash -e

# Enable jemalloc for reduced memory usage and latency.
if [ -z "${LD_PRELOAD+x}" ]; then
    LD_PRELOAD=$(find /usr/lib -name libjemalloc.so.2 -print -quit)
    export LD_PRELOAD
fi

# Determine Rails environment
RAILS_ENV=${RAILS_ENV:-production}
echo "Rails environment: ${RAILS_ENV}"

# Handle credentials
echo "Setting up credentials for ${RAILS_ENV}..."

# Web and sidekiq start concurrently and share the credentials volume,
# so generation must be serialized to avoid overwriting each other's key/enc files.
CREDENTIALS_LOCK="/rails/config/credentials/.credentials.lock"
mkdir -p /rails/config/credentials
chmod 755 /rails/config/credentials
exec 200>"${CREDENTIALS_LOCK}"
flock -w 60 200 || { echo "Failed to acquire credentials lock"; exit 1; }

if [ "$RAILS_ENV" = "production" ]; then
    CREDENTIALS_FILE="/rails/config/credentials/production.yml.enc"
    CREDENTIALS_KEY="/rails/config/credentials/production.key"
    if [ -f "$CREDENTIALS_KEY" ] && [ -f "$CREDENTIALS_FILE" ]; then
        echo "Using existing production credentials"
        export RAILS_MASTER_KEY=$(cat "$CREDENTIALS_KEY")
    else
        mkdir -p /rails/config/credentials
        chmod 755 /rails/config/credentials
        RAILS_MASTER_KEY=$(openssl rand -hex 16)
        echo "${RAILS_MASTER_KEY}" > "$CREDENTIALS_KEY"
        chmod 600 "$CREDENTIALS_KEY"
        export RAILS_MASTER_KEY
        SECRET_KEY_BASE=$(openssl rand -hex 64)
        TEMP_CREDENTIALS="/tmp/credentials_content.yml"
        cat > "${TEMP_CREDENTIALS}" << EOF
secret_key_base: ${SECRET_KEY_BASE}
EOF
        echo "Creating credentials file: ${CREDENTIALS_FILE}"
        EDITOR="cp ${TEMP_CREDENTIALS}" bin/rails credentials:edit --environment="${RAILS_ENV}" 2>/dev/null || {
            bin/rails runner "
            require 'active_support/encrypted_file'
            content = File.read('${TEMP_CREDENTIALS}')
            encrypted_file = Rails.application.encrypted('config/credentials/production.yml.enc', key_path: 'config/credentials/production.key')
            encrypted_file.write(content)
            puts 'Credentials file created successfully'
            " --environment="${RAILS_ENV}"
        }
        rm -f "${TEMP_CREDENTIALS}"
        echo "Fresh credentials generated successfully for ${RAILS_ENV}!"
    fi
else
    CREDENTIALS_FILE="/rails/config/credentials.yml.enc"
    MASTER_KEY_FILE="/rails/config/master.key"
    if [ -f "$MASTER_KEY_FILE" ] && [ -f "$CREDENTIALS_FILE" ]; then
        echo "Using existing credentials"
        export RAILS_MASTER_KEY=$(cat "$MASTER_KEY_FILE")
    else
        mkdir -p /rails/config/credentials
        chmod 755 /rails/config/credentials
        RAILS_MASTER_KEY=$(openssl rand -hex 16)
        echo "${RAILS_MASTER_KEY}" > "$MASTER_KEY_FILE"
        chmod 600 "$MASTER_KEY_FILE"
        export RAILS_MASTER_KEY
        SECRET_KEY_BASE=$(openssl rand -hex 64)
        TEMP_CREDENTIALS="/tmp/credentials_content.yml"
        cat > "${TEMP_CREDENTIALS}" << EOF
secret_key_base: ${SECRET_KEY_BASE}
EOF
        echo "Creating credentials file: ${CREDENTIALS_FILE}"
        EDITOR="cp ${TEMP_CREDENTIALS}" bin/rails credentials:edit --environment="${RAILS_ENV}" 2>/dev/null || {
            bin/rails runner "
            require 'active_support/encrypted_file'
            content = File.read('${TEMP_CREDENTIALS}')
            encrypted_file = Rails.application.encrypted('config/credentials.yml.enc')
            encrypted_file.write(content)
            puts 'Credentials file created successfully'
            " --environment="${RAILS_ENV}"
        }
        rm -f "${TEMP_CREDENTIALS}"
        echo "Fresh credentials generated successfully for ${RAILS_ENV}!"
    fi
fi

# Release the credentials lock; the fd would otherwise stay held for the
# lifetime of the process and block other containers (sidekiq/web).
exec 200>&-

# Handle database setup with proper error handling
echo "Setting up database..."

# Web and sidekiq both run this entrypoint; serialize migrations with a lock
# on the shared storage volume so concurrent containers don't fail with
# ConcurrentMigrationError.
DB_LOCK="/rails/storage/db_setup.lock"
exec 201>"${DB_LOCK}"
flock -w 180 201 || { echo "Failed to acquire database setup lock"; exit 1; }

# db:prepare creates the database if missing, loads the schema and applies
# pending migrations. Never drop/reset the database here — that would destroy
# production data on a transient migration failure.
if bin/rails db:prepare; then
    echo "Database setup completed!"
else
    echo "Database setup FAILED"
    exit 1
fi

# Release the database setup lock
exec 201>&-

exec "${@}"
